# Copy to .env.local for development, or set these on Vercel. With none of
# the optional ones set, the site runs on a local SQLite file and picking a
# plan puts the account on it without payment.

# ─── Site ───
# Where this deployment answers, https://caveira.ai in production. Used for
# Stripe's return urls and the login link the clients open. Unset, it is read
# from each request.
APP_URL=

# ─── Database ───
# Unset: local.db in this folder. Production needs Turso:
#   turso db create caveira
#   turso db show --url caveira        → TURSO_DATABASE_URL
#   turso db tokens create caveira     → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Models ───
# caveira's own abliteration.ai key. It never leaves the server: the clients
# send their account token, and the proxy swaps this in.
ABLITERATION_API_KEY=
# ABLITERATION_BASE_URL=https://api.abliteration.ai/v1

# One Free plan's worth of usage a month, in dollars of model cost. Paid plans
# get 2x, 5x, 10x and 20x this.
USAGE_UNIT_USD=5

# ─── Stripe ───
# A restricted key (rk_…) with write access to Customers, Checkout Sessions,
# Customer portal and Subscriptions, and read access to Prices. Without one in
# development, plans switch without payment; production refuses to.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret, or what
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# prints. Without it, every delivery is refused.
STRIPE_WEBHOOK_SECRET=
